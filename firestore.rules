rules_version = '2';

// Deploy: npx firebase deploy --only firestore --project <project-id>
//
// Collections
// - users/{uid}            private progress backup (owner only)
// - leaderboard/{uid}      public leaderboard row (opted-in, verified users)
// - countryTallies/{key}   public vote counts per country (authoritative)
// - aggregates/countryTallies   all countries' counts in one doc (mirror)
// - countryVotes/{key}/voters/{uid}   each user's own vote per country
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    function boundedInt(v, lo, hi) {
      return v is int && v >= lo && v <= hi;
    }

    // Private backup: aggregated progress only (never raw scans or barcodes),
    // plus the user's own vote choices so they follow the account.
    match /users/{userId} {
      allow get: if isOwner(userId);

      // LEGACY (app <= 1.0.2 reads the leaderboard from this collection).
      // Firestore checks the query's own filter against this condition, so
      // only queries restricted to opted-in users are allowed, and documents
      // of users who did not opt in can never be listed.
      // TODO: remove once 1.0.2 usage is negligible (then also delete the
      // composite index in firestore.indexes.json).
      allow list: if signedIn() && resource.data.leaderboardOptIn == true;

      allow create, update: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() <= 60
                    && (request.resource.data.leaderboardOptIn == false || verified());

      allow delete: if isOwner(userId);
    }

    // Public leaderboard: only what the leaderboard screen shows.
    match /leaderboard/{userId} {
      allow read: if true;

      allow create, update: if isOwner(userId)
                    && verified()
                    && request.resource.data.keys().hasOnly(
                         ["uid", "displayName", "xp", "level", "currentStreak", "longestStreak", "updatedAt"])
                    && request.resource.data.uid == userId
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() > 0
                    && request.resource.data.displayName.size() <= 30
                    && boundedInt(request.resource.data.xp, 0, 10000000)
                    && boundedInt(request.resource.data.level, 1, 50)
                    && boundedInt(request.resource.data.currentStreak, 0, 100000)
                    && boundedInt(request.resource.data.longestStreak, 0, 100000)
                    && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner(userId);
    }

    // --- Vote tallies -------------------------------------------------------
    // A tally may only move by the caller's own vote, recorded in the same
    // request: the change in counts must equal the change between the voter
    // doc before (get) and after (getAfter) the request. Clients clamp at 0,
    // so a decrement below zero must land on exactly 0.
    function voterDoc(key) {
      return /databases/$(database)/documents/countryVotes/$(key)/voters/$(request.auth.uid);
    }
    function choiceBefore(key) {
      return exists(voterDoc(key)) ? get(voterDoc(key)).data.choice : "none";
    }
    function choiceAfter(key) {
      return existsAfter(voterDoc(key)) ? getAfter(voterDoc(key)).data.choice : "none";
    }
    function delta(key, side) {
      return (choiceAfter(key) == side ? 1 : 0) - (choiceBefore(key) == side ? 1 : 0);
    }
    function movedBy(before, d, after) {
      return (before + d >= 0 && after == before + d) || (before + d < 0 && after == 0);
    }
    function countBefore(field) {
      return resource == null ? 0 : resource.data[field];
    }

    // Public vote tallies (one doc per country, ~110 total). Authoritative
    // counts; aggregates/countryTallies mirrors them for cheap reads.
    match /countryTallies/{countryKey} {
      allow read: if true;

      allow create, update: if verified()
                    && request.resource.data.keys().hasOnly(["country", "upvotes", "downvotes", "updatedAt"])
                    && request.resource.data.country is string
                    && request.resource.data.country.size() <= 64
                    && boundedInt(request.resource.data.upvotes, 0, 100000000)
                    && boundedInt(request.resource.data.downvotes, 0, 100000000)
                    && movedBy(countBefore("upvotes"), delta(countryKey, "up"), request.resource.data.upvotes)
                    && movedBy(countBefore("downvotes"), delta(countryKey, "down"), request.resource.data.downvotes);

      allow delete: if false;
    }

    // Every country's counts in one doc, so reading all of them costs 1 read.
    //   { tallies: { <key>: {country, upvotes, downvotes} }, changedKey, updatedAt, syncedAt }
    // Writes either mirror exactly one country from its authoritative tally
    // (as it stands after the request), or claim the daily reconcile.
    function tallyDoc(key) {
      return /databases/$(database)/documents/countryTallies/$(key);
    }
    function isMirrorUpdate() {
      let next = request.resource.data;
      let k = next.changedKey;
      let entry = next.tallies[k];
      let source = getAfter(tallyDoc(k)).data;
      return k is string
          && k.matches("^[a-z0-9-]{1,64}$")
          && next.diff(resource.data).affectedKeys().hasOnly(["tallies", "changedKey", "updatedAt"])
          && next.updatedAt == request.time
          && next.tallies.diff(resource.data.tallies).affectedKeys().hasOnly([k])
          && entry.keys().hasOnly(["country", "upvotes", "downvotes"])
          && entry.country is string
          && entry.upvotes == source.upvotes
          && entry.downvotes == source.downvotes;
    }
    function isReconcileClaim() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["syncedAt"])
          && request.resource.data.syncedAt == request.time
          && resource.data.syncedAt < request.time - duration.value(23, "h");
    }

    match /aggregates/countryTallies {
      allow read: if true;

      allow create: if verified()
                    && request.resource.data.keys().hasOnly(["tallies", "syncedAt"])
                    && request.resource.data.tallies == {}
                    && request.resource.data.syncedAt == request.time;

      allow update: if verified() && (isMirrorUpdate() || isReconcileClaim());

      allow delete: if false;
    }

    // Each user's vote per country. "none" is a retraction tombstone.
    // Owners may delete their own records (account deletion).
    match /countryVotes/{countryKey}/voters/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
                    && verified()
                    && request.resource.data.keys().hasOnly(["choice", "updatedAt"])
                    && request.resource.data.choice in ["up", "down", "none"];
      allow delete: if isOwner(uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
