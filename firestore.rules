rules_version = '2';

// Paste this into Firebase Console → Firestore Database → Rules → Publish.
//
// Data model: one document per signed-in user at users/{uid}, holding only
// an aggregated gamification summary (xp, level, streaks, badges, daily scan
// counts) — never raw scan/barcode data. See lib/cloudSync.ts.
//
// - Every user can read/write only their own document.
// - Any signed-in user can read another user's document ONLY if that user
//   opted into the public leaderboard (leaderboardOptIn == true) — this is
//   what powers the leaderboard query in lib/cloudSync.ts (fetchLeaderboard).
// - No one can read/write anything outside /users/{uid}.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow get: if request.auth != null &&
                    (request.auth.uid == userId || resource.data.leaderboardOptIn == true);

      // Needed for the leaderboard's collection query (where leaderboardOptIn == true,
      // orderBy xp desc). Firestore rules can't filter individual documents out of a
      // "list" result by field value, so any signed-in user can technically issue a
      // raw query — this is an accepted trade-off given the doc only ever contains
      // non-sensitive aggregated stats (no email, no raw scan history).
      allow list: if request.auth != null;

      // leaderboardOptIn may only be set to true when the account's email is
      // verified (request.auth.token.email_verified comes from the ID token,
      // refreshed via reload()+getIdToken(true) client-side before writing).
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && (request.resource.data.leaderboardOptIn == false
                        || request.auth.token.email_verified == true);

      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && (request.resource.data.leaderboardOptIn == false
                        || request.auth.token.email_verified == true);

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Public, always-visible community vote tallies (one doc per country,
    // ~80 total, never grows) — anyone (signed in or not) may read; only
    // casting a vote (via the client's runTransaction in lib/votes.ts, which
    // updates both this doc and the voter's own record together) can mutate
    // it, and only by a signed-in + email-verified user.
    match /countryTallies/{countryKey} {
      allow read: if true;

      allow create, update: if request.auth != null
                    && request.auth.token.email_verified == true
                    && request.resource.data.country is string
                    && request.resource.data.upvotes is int
                    && request.resource.data.downvotes is int
                    && request.resource.data.upvotes >= 0
                    && request.resource.data.downvotes >= 0
                    && request.resource.data.keys().hasOnly(["country", "upvotes", "downvotes", "updatedAt"]);

      allow delete: if false;
    }

    // Per-user, per-country vote record — only that user may read/write
    // their own vote; requires a verified email, matching the tally rule
    // above so the two writes in the client transaction are governed by
    // the same auth precondition. "none" is a retraction tombstone (see
    // lib/votes.ts retractVote) — the doc is never deleted so a user can't
    // farm first-vote XP by retracting and re-voting on the same country.
    match /countryVotes/{countryKey}/voters/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
                    && request.auth.uid == uid
                    && request.auth.token.email_verified == true
                    && request.resource.data.choice in ["up", "down", "none"]
                    && request.resource.data.keys().hasOnly(["choice", "updatedAt"]);
      allow delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
