rules_version = '2';

// Deploy: npx firebase deploy --only firestore --project <project-id>
//
// Collections
// - users/{uid}            private progress backup (owner only)
// - leaderboard/{uid}      public leaderboard row (opted-in, verified users)
// - countryTallies/{key}   public vote counts per country
// - countryVotes/{key}/voters/{uid}   each user's own vote per country
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    function boundedInt(v, lo, hi) {
      return v is int && v >= lo && v <= hi;
    }

    // Private backup: aggregated progress only (never raw scans or barcodes),
    // plus the user's own vote choices so they follow the account.
    match /users/{userId} {
      allow get: if isOwner(userId);

      // LEGACY (app <= 1.0.2 reads the leaderboard from this collection).
      // Firestore checks the query's own filter against this condition, so
      // only queries restricted to opted-in users are allowed, and documents
      // of users who did not opt in can never be listed.
      // TODO: remove once 1.0.2 usage is negligible (then also delete the
      // composite index in firestore.indexes.json).
      allow list: if signedIn() && resource.data.leaderboardOptIn == true;

      allow create, update: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() <= 60
                    && (request.resource.data.leaderboardOptIn == false || verified());

      allow delete: if isOwner(userId);
    }

    // Public leaderboard: only what the leaderboard screen shows.
    match /leaderboard/{userId} {
      allow read: if true;

      allow create, update: if isOwner(userId)
                    && verified()
                    && request.resource.data.keys().hasOnly(
                         ["uid", "displayName", "xp", "level", "currentStreak", "longestStreak", "updatedAt"])
                    && request.resource.data.uid == userId
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() > 0
                    && request.resource.data.displayName.size() <= 30
                    && boundedInt(request.resource.data.xp, 0, 10000000)
                    && boundedInt(request.resource.data.level, 1, 50)
                    && boundedInt(request.resource.data.currentStreak, 0, 100000)
                    && boundedInt(request.resource.data.longestStreak, 0, 100000)
                    && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner(userId);
    }

    // Public vote tallies (one doc per country, ~110 total). Only mutated by
    // the client transaction in lib/votes.ts that also writes the voter doc.
    match /countryTallies/{countryKey} {
      allow read: if true;

      allow create, update: if verified()
                    && request.resource.data.keys().hasOnly(["country", "upvotes", "downvotes", "updatedAt"])
                    && request.resource.data.country is string
                    && request.resource.data.country.size() <= 64
                    && boundedInt(request.resource.data.upvotes, 0, 100000000)
                    && boundedInt(request.resource.data.downvotes, 0, 100000000);

      allow delete: if false;
    }

    // Each user's vote per country. "none" is a retraction tombstone.
    // Owners may delete their own records (account deletion).
    match /countryVotes/{countryKey}/voters/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
                    && verified()
                    && request.resource.data.keys().hasOnly(["choice", "updatedAt"])
                    && request.resource.data.choice in ["up", "down", "none"];
      allow delete: if isOwner(uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
