{
  "name": "solidarity",
  "main": "expo-router/entry",
  "version": "1.1.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "doctor": "npx expo-doctor",
    "verify": "npm run typecheck && npm run lint && npm test",
    "icons": "python scripts/generate-icons.py",
    "screenshots": "node scripts/screenshots.mjs",
    "flags": "node scripts/generate-flags.mjs",
    "test:rules": "node scripts/test-rules.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/rules/"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@types/jest": "30.0.0",
    "expo": "~58.0.26",
    "expo-blur": "~58.0.6",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-media-library": "~58.0.14",
    "expo-notifications": "~58.1.9",
    "expo-quick-actions": "^6.0.2",
    "expo-router": "~58.0.32",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "firebase": "^13.4.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@react-native/jest-preset": "^0.88.1",
    "@types/react": "~19.3.0",
    "country-flag-icons": "^1.6.20",
    "eslint-config-expo": "~58.0.4",
    "playwright-core": "^1.65.1",
    "typescript": "~6.0.3"
  },
  "private": true
}
